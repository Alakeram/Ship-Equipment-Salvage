<?xml version="1.0" encoding="utf-8"?>
<aiscript name="order.ses.salvage.routine" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" version="2">
  <!-- SES Auto-Salvage default behaviour (Marek, 2026-10-10). Loops: find the
       nearest eligible S/M wreck that no other SES ship is working, run the
       Salvage Wreck order on it (order.ses.salvage.wreck), repeat; waits and
       searches again when none is left.
       Area (Marek, 2026-10-11): optional destination + radius like vanilla
       Protect Position / Collect Drops. Without a destination it works the
       ship's current sector as before.
       Offered as a default behaviour (category salvage + duration infinitevalue,
       like vanilla SalvageRoutine). <requires> keeps it selectable only for ships
       carrying a Riptide salvage laser or turret; other ships see it greyed out,
       and the description (the greyed entry's tooltip) names the requirement. -->
  <order id="SESSalvageRoutine" name="{1171361,936}" description="{1171361,937}" category="salvage" allowinloop="false">
    <params>
      <param name="destination" type="position" text="{1041, 10027}" comment="Optional area: [space, position]. With radius it limits where wrecks are searched. Null = the ship's current sector.">
        <input_param name="class" value="class.sector"/>
        <patch value="null" sinceversion="2"/>
      </param>
      <param name="radius" type="length" default="this.ship.maxradarrange" text="{1041, 10093}" comment="Radius around the area">
        <input_param name="min" value="1km"/>
        <input_param name="max" value="[this.ship.maxradarrange, 1km].max"/>
        <input_param name="step" value="1km"/>
        <patch value="this.ship.maxradarrange" sinceversion="2"/>
      </param>
      <param name="duration" default="0s" type="time" infinitevalue="0s" advanced="true" text="{1041,10034}" comment="Duration">
        <input_param name="startvalue" value="0s"/>
        <input_param name="min" value="0s"/>
        <input_param name="max" value="24h"/>
        <input_param name="step" value="1min"/>
      </param>
      <param name="debugchance" type="bool" default="0" advanced="true" text="{1041,10086}" comment="Print debug output">
        <input_param name="truevalue" value="100"/>
      </param>
    </params>
    <requires>
      <match class="class.spacesuit" negate="true"/>
      <match_any>
        <match_child macro="macro.ses_turret_rip_m_salvage_01_mk1_macro"/>
        <match_child macro="macro.ses_weapon_m_salvage_01_mk1_macro"/>
        <match_child macro="macro.ses_weapon_s_salvage_01_mk1_macro"/>
      </match_any>
    </requires>
    <location object="$destination.{1}" position="$destination.{2}" radius="$radius" condition="@$destination.{1}.exists"/>
  </order>
  <interrupts>
    <handler ref="SectorChangeHandler"/>
    <handler ref="AttackHandler"/>
    <handler ref="MissileLockHandler"/>
    <handler ref="ScannedHandler"/>
    <handler ref="InspectedHandler"/>
    <handler ref="ResupplyHandler"/>
  </interrupts>
  <init>
    <set_value name="$time_start" exact="player.age"/>
  </init>
  <attention min="unknown">
    <actions>
      <label name="start"/>
      <!-- Salvage gear check (same list as every salvage hit path). -->
      <set_value name="$hasgear" exact="false"/>
      <do_for_each name="$gear" in="this.assignedcontrolled.weapons.operational.list">
        <do_if value="@global.$SES_Salvage_Gear_Macros.indexof.{$gear.macro.id}">
          <set_value name="$hasgear" exact="true"/>
        </do_if>
      </do_for_each>
      <do_if value="not $hasgear">
        <debug_text text="'[SES][ROUTINE] Auto-Salvage refused: %s has no salvage gear.'.[this.assignedcontrolled]" chance="$debugchance"/>
        <do_if value="@this.assignedcontrolled.order.isrunning">
          <set_order_failed order="this.assignedcontrolled.order" text="{1171361,933}"/>
        </do_if>
        <return/>
      </do_if>
      <set_value name="$hasarea" exact="@$destination.{1}.exists"/>

      <label name="search"/>
      <!-- Required for every infinite order (vanilla order.fight.patrol). -->
      <do_if value="@this.assignedcontrolled.order">
        <set_order_syncpoint_reached order="this.assignedcontrolled.order"/>
      </do_if>
      <do_if value="$duration gt 0s and player.age gt $time_start + $duration">
        <return/>
      </do_if>
      <!-- Go to the chosen area first (vanilla Collect Drops does the same). -->
      <do_if value="$hasarea and (this.sector != $destination.{1} or this.assignedcontrolled.distanceto.{$destination} gt [$radius, 10km].max)">
        <run_script name="'move.generic'" result="$movesuccess">
          <param name="destination" value="$destination.{1}"/>
          <param name="position" value="$destination.{2}"/>
          <param name="debugchance" value="$debugchance"/>
        </run_script>
        <do_if value="not $movesuccess">
          <debug_text text="'[SES][ROUTINE] Auto-Salvage: cannot reach the area; waiting.'" chance="$debugchance"/>
          <wait min="40s" max="80s"/>
          <resume label="search"/>
        </do_if>
      </do_if>
      <!-- Per-ship record of wrecks handed to Salvage Wreck. The order restarts
           after each queued Salvage Wreck, so it lives in a global; a wreck that
           is still eligible after two tries (unreachable, order failed) is
           skipped. Reset after 15 min without a pick. -->
      <do_if value="not @global.$SES_Salvage_Tried">
        <set_value name="global.$SES_Salvage_Tried" exact="table[]"/>
      </do_if>
      <do_if value="not @global.$SES_Salvage_Tried.{this.assignedcontrolled} or player.age gt global.$SES_Salvage_Tried.{this.assignedcontrolled}.$time + 15min">
        <set_value name="global.$SES_Salvage_Tried.{this.assignedcontrolled}" exact="table[$time = player.age, $wrecks = table[]]"/>
      </do_if>
      <set_value name="$tried" exact="global.$SES_Salvage_Tried.{this.assignedcontrolled}.$wrecks"/>
      <set_value name="$best" exact="null"/>
      <set_value name="$bestdist" exact="0m"/>
      <find_ship name="$candidates" space="if $hasarea then $destination.{1} else this.assignedcontrolled.sector" multiple="true" checkoperational="false"/>
      <do_for_each name="$candidate" in="$candidates">
        <do_if value="$candidate.iswreck and ($candidate.isrealclass.ship_s or $candidate.isrealclass.ship_m) and (not $hasarea or $candidate.distanceto.{$destination} le $radius) and not @$candidate.tugship and not @$candidate.dismantlingobject and not @$candidate.salvageclaimants.count and not @global.$SES_Wreck_Harvest_State.{$candidate}.$exhausted and (if @$tried.{$candidate} then $tried.{$candidate} else 0) lt 2">
          <!-- Leave wrecks another SES ship is already working. -->
          <set_value name="$taken" exact="false"/>
          <do_for_each name="$requester" valuename="$request" in="if @global.$SES_Salvage_Requests then global.$SES_Salvage_Requests else table[]">
            <do_if value="$requester != this.assignedcontrolled and @$requester.exists and @$request.$wreck == $candidate">
              <set_value name="$taken" exact="true"/>
            </do_if>
          </do_for_each>
          <do_if value="not $taken">
            <set_value name="$dist" exact="this.assignedcontrolled.distanceto.{$candidate}"/>
            <do_if value="not $best or $dist lt $bestdist">
              <set_value name="$best" exact="$candidate"/>
              <set_value name="$bestdist" exact="$dist"/>
            </do_if>
          </do_if>
        </do_if>
      </do_for_each>
      <remove_value name="$candidates"/>
      <do_if value="$best">
        <set_value name="$tried.{$best}" exact="(if @$tried.{$best} then $tried.{$best} else 0) + 1"/>
        <set_value name="global.$SES_Salvage_Tried.{this.assignedcontrolled}.$time" exact="player.age"/>
      </do_if>

      <do_if value="not $best">
        <debug_text text="'[SES][ROUTINE] Auto-Salvage: no eligible wreck; waiting.'" chance="$debugchance"/>
        <wait min="40s" max="80s"/>
        <resume label="search"/>
      </do_if>

      <debug_text text="'[SES][ROUTINE] Auto-Salvage: %s salvages %s (area=%s).'.[this.assignedcontrolled, $best, $hasarea]" chance="if @global.$SES_Debug_Log_Chance then global.$SES_Debug_Log_Chance else 0"/>
      <!-- Queue the Salvage Wreck order ahead of this default behaviour, as
           vanilla Auto-Mine does with MiningCollect. Running it as a sub-script
           instead left the turrets idle (MCP run 38); the queued order fires
           exactly like a player-given one. This script carries on after it. -->
      <create_order object="this.assignedcontrolled" id="'SESSalvageWreck'" immediate="true">
        <param name="target" value="$best"/>
        <param name="debugchance" value="$debugchance"/>
      </create_order>
      <!-- very short wait to let the new order start (vanilla order.mining.routine). -->
      <wait exact="1ms"/>
      <wait exact="2s"/>
      <resume label="search"/>
    </actions>
  </attention>
</aiscript>
