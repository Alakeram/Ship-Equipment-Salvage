<?xml version="1.0" encoding="utf-8"?>
<macros>
  <!-- Riptide Salvage Turret M: vanilla integrated M mining turret model and beam
       on an SES component with a combat mount tag, so it fits any M-ship turret
       slot, not only miners. Was the Manticore scrap/tow beam until 2026-10-10.
       Only SES salvage gear harvests wrecks. -->
  <macro name="ses_turret_rip_m_salvage_01_mk1_macro" class="turret">
    <component ref="ses_turret_rip_m_salvage_01_mk1" />
    <properties>
      <identification name="{1171361,920}" basename="{1171361,923}" shortname="{1171361,924}" description="{1171361,922}" mk="1" />
      <bullet class="bullet_gen_turret_m_mining_01_mk1_macro" />
      <rotationspeed max="120" />
      <rotationacceleration max="240" />
      <hull threshold="0.2" integrated="1" />
    </properties>
  </macro>
</macros>